# Copy to .env and fill in. Never commit .env.

# The key fingerprint printed by:
#   docker run --rm ghcr.io/dvarahq/dvara-gateway-oss:1.13.0 --generate-key --name spring-ai-demo --workspace default
# Paste the key_hash value, including the sha256: prefix.
DVARA_KEY_HASH=sha256:<the-hash-printed-by-keygen>

# Signs the audit chain. Generate one with: openssl rand -base64 32
DVARA_AUDIT_HMAC_SECRET=<generate-with-openssl-rand-base64-32>

# Host port for the gateway. Change it if 8080 is taken.
DVARA_PORT=8080
