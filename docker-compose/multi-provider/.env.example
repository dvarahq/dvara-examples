# Optional. Blank runs every feature, including MCP and A2A, limited to 3 workspaces
# and 100,000 calls a month, for non-production use. A DVARA- licence from your account
# team lifts the limits. It is copied into Flightdeck once; renew it on the Licence page.
DVARA_LICENSE_KEY=

# Required (1.8.2). The gateway enrols with Flightdeck using this shared secret. At least
# 32 characters; both services read the same value. Generate: openssl rand -base64 32
DVARA_ENROLMENT_SECRET=

# Required secrets. Generate EACH one on its own with `openssl rand -base64 32`
# (32 random bytes; never use a shorter value). Replace every placeholder below.
# DVARA_ENCRYPTION_MASTER_PASSWORD: AES-256-GCM key for ENCRYPTED-mode credentials.
#   ESCROW OFFLINE — loss bricks every encrypted provider credential.
DVARA_ENCRYPTION_MASTER_PASSWORD=replace-with-openssl-rand-output
# Two distinct Bearer keys for the actuator chain (must differ):
DVARA_ACTUATOR_API_KEY=replace-with-openssl-rand-output
# Audit HMAC secret — the same on both services; keep it stable. It signs the audit chain,
# and the A2A delegation guard derives its signing key from it. From 1.8.4 the guard refuses
# a placeholder (like the one below) or a secret under 32 bytes: on this stack's default
# (dev) profile the gateway logs a WARN and runs the guard off; a production profile
# won't start. Use openssl rand -base64 32:
DVARA_AUDIT_HMAC_SECRET=replace-with-openssl-rand-output
# PII token key — Flightdeck only; the gateway fetches PII keys from Flightdeck and needs
# no copy. ESCROW OFFLINE: losing it makes every PII token unrecoverable.
DVARA_PII_TOKEN_ENCRYPTION_MASTER_PASSWORD=replace-with-openssl-rand-output
DVARA_ACTUATOR_METRICS_API_KEY=replace-with-different-openssl-rand-output
DB_PASSWORD=dvara

# Set whichever keys you have; either is enough to start.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Add more providers by uncommenting the matching lines in docker-compose.yml
# and setting the values here. Supported: Gemini, Mistral, Cohere, Groq,
# Azure OpenAI, Bedrock, Ollama. Full list: https://dvarahq.com/docs/core-concepts/providers
# GEMINI_API_KEY=AIza...
# MISTRAL_API_KEY=
# COHERE_API_KEY=
# GROQ_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_BASE_URL=

# Every /v1 request carries a gateway API key: create one in the Console and send it as
# `Authorization: Bearer gw_...`. This is not configurable. DVARA_LLM_GATEWAY_REQUIRE_API_KEY
# was removed in gateway 1.8.0; a gateway started with it set to `false` refuses to start.

# Optional (1.8.5): the gateway URL an A2A peer posts push notifications to.
# Defaults to http://dvara-gateway:8080, which only a peer on this Compose
# network reaches. Set it to the gateway's public URL for any other peer.
# A2A_PUSH_CALLBACK_BASE_URL=https://gateway.example.com
